{
    "name": "webcrawler/advanced",
    "description": "Web crawler and media file downloader with optional headless-browser fetching",
    "version": "2.0.0",
    "type": "project",
    "require": {
        "php": ">=7.4",
        "symfony/panther": "^2.4"
    },
    "autoload": {
        "psr-4": {
        "WebCrawler\\": "includes/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    }
}
