\subsection{File Size Retrieval Endpoint}
\textbf{File:} \texttt{api/get\_file\_sizes.php}

\textbf{Purpose:} Performs batch HEAD requests to determine file sizes without downloading content. Essential for displaying accurate file metadata in the UI.

\textbf{Request Method:} \texttt{POST}

\textbf{Implementation:}
\begin{lstlisting}[language=PHP, caption={Batch File Size Checking}, label={lst:api_file_sizes}]
function getFileSize($url) {
    $ch = curl_init($url);
    curl_setopt_array($ch, [
        CURLOPT_RETURNTRANSFER => true,
        CURLOPT_HEADER => true,
        CURLOPT_NOBODY => true,  // HEAD request only
        CURLOPT_FOLLOWLOCATION => true,
        CURLOPT_TIMEOUT => 5,
        CURLOPT_SSL_VERIFYPEER => false
    ]);
    
    curl_exec($ch);
    $contentLength = curl_getinfo($ch, CURLINFO_CONTENT_LENGTH_DOWNLOAD);
    curl_close($ch);
    
    if ($contentLength > 0) {
        return formatFileSize($contentLength);
    }
    return 'Unknown';
}

function formatFileSize($bytes) {
    if ($bytes >= 1073741824) {
        return number_format($bytes / 1073741824, 2) . ' GB';
    } elseif ($bytes >= 1048576) {
        return number_format($bytes / 1048576, 2) . ' MB';
    } elseif ($bytes >= 1024) {
        return number_format($bytes / 1024, 2) . ' KB';
    }
    return $bytes . ' B';
}
\end{lstlisting}

