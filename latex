\subsection{Bulk ZIP Download Endpoint}
\textbf{File:} \texttt{api/download\_zip.php}

\textbf{Purpose:} Aggregates multiple remote files into a single ZIP archive with automatic filename collision resolution.

\textbf{Key Features:}
\begin{itemize}
    \item Handles duplicate filenames by appending numerical suffixes
    \item Streams ZIP file directly to browser without disk storage
    \item Implements error handling for failed downloads
\end{itemize}

\begin{lstlisting}[language=PHP, caption={ZIP Archive Generation with Collision Handling}, label={lst:api_zip_download}]
$zip = new ZipArchive();
$zipFilename = sys_get_temp_dir() . '/crawler_' . uniqid() . '.zip';
$zip->open($zipFilename, ZipArchive::CREATE | ZipArchive::OVERWRITE);

$addedNames = [];
foreach ($files as $fileUrl) {
    $filename = basename(parse_url($fileUrl, PHP_URL_PATH));
    
    // Download file content
    $ch = curl_init($fileUrl);
    curl_setopt($ch, CURLOPT_RETURNTRANSFER, true);
    curl_setopt($ch, CURLOPT_TIMEOUT, 30);
    $fileContent = curl_exec($ch);
    $httpCode = curl_getinfo($ch, CURLINFO_HTTP_CODE);
    curl_close($ch);
    
    if ($httpCode >= 200 && $httpCode < 300) {
        // Handle duplicate filenames
        $baseName = pathinfo($filename, PATHINFO_FILENAME);
        $extension = pathinfo($filename, PATHINFO_EXTENSION);
        $finalFilename = $filename;
        $counter = 1;
        
        while (isset($addedNames[$finalFilename])) {
            $finalFilename = $baseName . '_' . $counter . 
                ($extension ? '.' . $extension : '');
            $counter++;
        }
        
        $zip->addFromString($finalFilename, $fileContent);
        $addedNames[$finalFilename] = true;
    }
}

$zip->close();

// Stream ZIP to browser
header('Content-Type: application/zip');
header('Content-Disposition: attachment; filename="crawler_files.zip"');
header('Content-Length: ' . filesize($zipFilename));
readfile($zipFilename);
unlink($zipFilename);
\end{lstlisting}

