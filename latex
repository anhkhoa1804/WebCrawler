\subsection{Core Components Implementation}

\subsubsection{The Crawler Engine (Logic Layer)}
The \texttt{WebCrawler} class is the heart of the application. Unlike simple scripts, it encapsulates the entire crawling lifecycle, managing the URL frontier and configuration state.

\begin{lstlisting}[language=PHP, caption={Core WebCrawler Class Structure}, label={lst:crawler_class}]
class WebCrawler {
    private $db;              // SQLite database instance
    private $multiCurl;       // Parallel fetcher
    private $loginHandler;    // Authentication handler
    private $maxDepth;
    
    public function crawl($url = null, $depth = 0) {
        // 1. Validation & Stop Conditions
        if ($depth > $this->maxDepth) return;
        if ($this->db && $this->db->isVisited($url)) return;
        if ($this->robotsChecker->isAllowed($url) === false) return;

        // 2. Mark as visited in database
        if ($this->db) $this->db->markVisited($url, $depth);

        // 3. Fetch Content (with authentication if configured)
        $html = $this->fetchUrl($url);

        // 4. Extract & Process
        $extracted = $this->extractLinks($html, $url);
        
        // 5. Recursive Traversal
        foreach ($extracted['links'] as $link) {
            $this->crawl($link, $depth + 1);
        }
    }
}
\end{lstlisting}


