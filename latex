\subsection{Frontend State Management}
The user interface relies on a polling mechanism to reflect the backend state. The \texttt{checkProgress} function in \texttt{script.js} uses the Fetch API with an \texttt{AbortController}. This sets a strict 3-second timeout for status checks, preventing the UI from hanging if the server becomes unresponsive. Additionally, the file filtering logic performs client-side sorting based on file metadata, prioritizing items with known sizes or specific categories like \texttt{documents} or \texttt{images} to improve user experience.

\subsection{Robots.txt Compliance Module}
Web scraping ethics require respecting the \texttt{robots.txt} protocol. The \texttt{RobotsChecker} class in \texttt{includes/robots\_checker.php} implements a lightweight parser that fetches and caches the target website's \texttt{robots.txt} file during crawler initialization.

The parser extracts all \texttt{Disallow} directives for the \texttt{User-agent: *} or specific user agent patterns. Before crawling each URL, the \texttt{isAllowed()} method performs a path prefix match to determine if the URL is prohibited. This ensures the crawler operates within legal and ethical boundaries without requiring manual rule configuration.

\begin{lstlisting}[language=PHP, caption={Robots.txt Parser and Validator}, label={lst:robots_checker}]
class RobotsChecker {
    private $robotsContent = '';
    private $disallowedPaths = [];
    private $userAgent = '*';
    
    public function __construct($baseUrl) {
        $this->loadRobotsTxt($baseUrl);
    }
    
    private function loadRobotsTxt($baseUrl) {
        $parsedUrl = parse_url($baseUrl);
        $robotsUrl = $parsedUrl['scheme'] . '://' . $parsedUrl['host'] . '/robots.txt';
        
        $ch = curl_init();
        curl_setopt($ch, CURLOPT_URL, $robotsUrl);
        curl_setopt($ch, CURLOPT_RETURNTRANSFER, true);
        curl_setopt($ch, CURLOPT_TIMEOUT, 5);
        $content = curl_exec($ch);
        $httpCode = curl_getinfo($ch, CURLINFO_HTTP_CODE);
        curl_close($ch);
        
        if ($httpCode === 200 && $content) {
            $this->robotsContent = $content;
            $this->parseRobotsTxt();
        }
    }
    
    private function parseRobotsTxt() {
        $lines = explode("\n", $this->robotsContent);
        $currentUserAgent = '';
        
        foreach ($lines as $line) {
            $line = trim($line);
            if (empty($line) || $line[0] === '#') continue;
            
            if (stripos($line, 'User-agent:') === 0) {
                $currentUserAgent = trim(substr($line, 11));
            }
            
            if (($currentUserAgent === '*' || $currentUserAgent === $this->userAgent) &&
                stripos($line, 'Disallow:') === 0) {
                $path = trim(substr($line, 9));
                if (!empty($path)) {
                    $this->disallowedPaths[] = $path;
                }
            }
        }
    }
    
    public function isAllowed($url) {
        if (empty($this->disallowedPaths)) return true;
        
        $path = parse_url($url, PHP_URL_PATH);
        if (!$path) return true;
        
        foreach ($this->disallowedPaths as $disallowedPath) {
            if ($disallowedPath === '/') return false;
            
            // Check prefix match
            if (strpos($path, $disallowedPath) === 0) {
                return false;
            }
            
            // Support wildcard patterns
            if (strpos($disallowedPath, '*') !== false) {
                $pattern = str_replace(['*', '/'], ['.*', '\/'], $disallowedPath);
                if (preg_match('/^' . $pattern . '/', $path)) {
                    return false;
                }
            }
        }
        return true;
    }
}
\end{lstlisting}

\subsection{Persistent Storage with SQLite}
To overcome the memory limitations of PHP arrays when crawling large websites (10,000+ pages), the system integrates a lightweight SQLite database via the \texttt{CrawlerDatabase} class in \texttt{includes/database.php}. This eliminates the risk of RAM exhaustion and allows for crawl session resumption.

The database schema consists of three normalized tables:
\begin{itemize}
    \item \texttt{urls}: Stores URL hashes, crawl depth, timestamps, HTTP status codes, and crawl status. Indexes are applied to the URL for $O(1)$ lookup performance via \texttt{isVisited()} method.
    \item \texttt{files}: Catalogs discovered resources with metadata (URL, filename, type, size, source URL, discovery timestamp). The \texttt{addFile()} method handles deduplication via UNIQUE constraints.
    \item \texttt{sessions}: Tracks crawl configurations (base URL, max depth, max pages) and progress states (pages crawled, files found, status). Supports resuming interrupted crawls via session IDs.
\end{itemize}

\begin{lstlisting}[language=PHP, caption={SQLite Database Initialization (database.php)}, label={lst:sqlite_init}]
class CrawlerDatabase {
    private $db;
    
    public function __construct($dbPath = null) {
        $this->dbPath = $dbPath ?? __DIR__ . '/../data/crawler.db';
        $dir = dirname($this->dbPath);
        if (!is_dir($dir)) {
            mkdir($dir, 0755, true);
        }
        
        $this->db = new PDO('sqlite:' . $this->dbPath);
        $this->db->setAttribute(PDO::ATTR_ERRMODE, PDO::ERRMODE_EXCEPTION);
        $this->initTables();
    }
    
    private function initTables() {
        // URLs table - tracks visited pages
        $this->db->exec('
            CREATE TABLE IF NOT EXISTS urls (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                url TEXT UNIQUE NOT NULL,
                base_url TEXT NOT NULL,
                status TEXT DEFAULT "pending",
                depth INTEGER DEFAULT 0,
                http_code INTEGER,
                crawled_at TIMESTAMP,
                created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
            )
        ');
        
        // Files table - stores discovered resources
        $this->db->exec('
            CREATE TABLE IF NOT EXISTS files (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                url TEXT UNIQUE NOT NULL,
                filename TEXT,
                type TEXT,
                size INTEGER,
                source_url TEXT,
                found_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
            )
        ');
        
        // Create indexes for fast lookups
        $this->db->exec('CREATE INDEX IF NOT EXISTS idx_urls_url ON urls(url)');
        $this->db->exec('CREATE INDEX IF NOT EXISTS idx_files_type ON files(type)');
    }
    
    public function isVisited($url) {
        $stmt = $this->db->prepare('SELECT 1 FROM urls WHERE url = ? LIMIT 1');
        $stmt->execute([$url]);
        return $stmt->fetch() !== false;
    }
    
    public function addFile($fileUrl, $filename, $type, $sourceUrl, $size = null) {
        $stmt = $this->db->prepare('
            INSERT OR IGNORE INTO files (url, filename, type, size, source_url)
            VALUES (?, ?, ?, ?, ?)
        ');
        $stmt->execute([$fileUrl, $filename, $type, $size, $sourceUrl]);
    }
}
\end{lstlisting}

\subsection{Parallel Processing via cURL Multi-Exec}
Standard PHP execution is synchronous (blocking). To maximize throughput, we implemented a parallel fetching engine in \texttt{includes/multi\_curl.php} using PHP's native \texttt{curl\_multi\_*} family of functions. This acts as a lightweight, in-memory queue system without needing external services like Redis.

The \texttt{MultiCurl} class manages a rolling window of concurrent connections (configurable, default 5-10 simultaneous requests). As soon as one request completes, the system processes the response via a callback function and immediately adds a new URL from the queue to the empty slot.

\begin{lstlisting}[language=PHP, caption={Parallel Processing Logic (multi\_curl.php)}, label={lst:curl_multi}, mathescape=false]
class MultiCurl {
    private $maxConnections = 10;
    private $timeout = 15;
    
    public function __construct($options = []) {
        $this->maxConnections = $options['max_connections'] ?? 10;
        $this->timeout = $options['timeout'] ?? 15;
    }
    
    public function fetchAll($urls, $callback = null) {
        $results = [];
        $chunks = array_chunk($urls, $this->maxConnections);
        
        foreach ($chunks as $chunk) {
            $chunkResults = $this->fetchChunk($chunk, $callback);
            $results = array_merge($results, $chunkResults);
        }
        return $results;
    }
    
    private function fetchChunk($urls, $callback = null) {
        $multiHandle = curl_multi_init();
        $curlHandles = [];
        
        // Add all URLs to multi handle
        foreach ($urls as $url) {
            $ch = $this->createCurlHandle($url);
            curl_multi_add_handle($multiHandle, $ch);
            $curlHandles[$url] = $ch;
        }
        
        // Execute all requests simultaneously
        $running = null;
        do {
            curl_multi_exec($multiHandle, $running);
            curl_multi_select($multiHandle);
        } while ($running > 0);
        
        // Collect results
        foreach ($curlHandles as $url => $ch) {
            $content = curl_multi_getcontent($ch);
            $httpCode = curl_getinfo($ch, CURLINFO_HTTP_CODE);
            
            $result = [
                'success' => $httpCode >= 200 && $httpCode < 400,
                'content' => $content,
                'http_code' => $httpCode
            ];
            
            if ($callback && is_callable($callback)) {
                $callback($url, $result);
            }
            
            curl_multi_remove_handle($multiHandle, $ch);
            curl_close($ch);
        }
        curl_multi_close($multiHandle);
    }
}
\end{lstlisting}

\subsection{Authenticated Crawling Module}
To access resources behind login screens (\texttt{Member Only} areas), the system includes a \texttt{LoginHandler} class in \texttt{includes/login\_handler.php}. This module simulates the browser's login process:

\begin{enumerate}
    \item \textbf{CSRF Extraction:} The \texttt{extractCsrfToken()} method fetches the login page and uses regex patterns to parse hidden tokens (CSRF, authenticity tokens) often required for valid submissions. Supports multiple token formats including hidden inputs and meta tags.
    \item \textbf{Credential Submission:} The \texttt{login()} method sends a \texttt{POST} or \texttt{GET} request (configurable via \texttt{\$options['method']}) with the username, password, and extracted tokens merged into the request body.
    \item \textbf{Session Maintenance:} The resulting authentication cookies are stored in the shared cookie jar file (\texttt{\$cookieFile}), which is then attached to all subsequent crawler requests via \texttt{fetchAuthenticated()} to maintain the logged-in state.
    \item \textbf{Login Verification:} The \texttt{verifyLogin()} method checks the response for success indicators (HTTP 200, presence of user profile elements) to confirm successful authentication.
\end{enumerate}

\begin{lstlisting}[language=PHP, caption={Login Handler with CSRF Token Extraction}, label={lst:login_handler}]
class LoginHandler {
    private $cookieFile;
    
    public function __construct($cookieFile = null) {
        $this->cookieFile = $cookieFile ?? sys_get_temp_dir() . '/login_cookies_' . uniqid() . '.txt';
    }
    
    public function login($loginUrl, $credentials, $options = []) {
        // Get login page to capture CSRF tokens
        if (isset($options['get_csrf']) && $options['get_csrf']) {
            $loginPage = $this->fetchPage($loginUrl);
            
            if ($loginPage) {
                $csrfToken = $this->extractCsrfToken($loginPage, $options['csrf_field'] ?? 'csrf_token');
                if ($csrfToken) {
                    $credentials[$options['csrf_field'] ?? 'csrf_token'] = $csrfToken;
                    error_log("[LOGIN] CSRF token found and added");
                }
            }
        }
        
        // Perform login request
        $ch = curl_init();
        curl_setopt($ch, CURLOPT_URL, $loginUrl);
        curl_setopt($ch, CURLOPT_POST, true);
        curl_setopt($ch, CURLOPT_POSTFIELDS, http_build_query($credentials));
        curl_setopt($ch, CURLOPT_RETURNTRANSFER, true);
        curl_setopt($ch, CURLOPT_COOKIEJAR, $this->cookieFile);
        curl_setopt($ch, CURLOPT_COOKIEFILE, $this->cookieFile);
        
        $response = curl_exec($ch);
        $httpCode = curl_getinfo($ch, CURLINFO_HTTP_CODE);
        curl_close($ch);
        
        return $this->verifyLogin($response, $httpCode, $options);
    }
    
    private function extractCsrfToken($html, $fieldName = 'csrf_token') {
        $patterns = [
            '/<input[^>]*name=["\']' . preg_quote($fieldName, '/') . '["\'][^>]*value=["\']([^"\']+)["\'][^>]*>/i',
            '/<meta[^>]*name=["\']csrf-token["\'][^>]*content=["\']([^"\']+)["\'][^>]*>/i'
        ];
        
        foreach ($patterns as $pattern) {
            if (preg_match($pattern, $html, $matches)) {
                return $matches[1];
            }
        }
        return null;
    }
    
    public function fetchAuthenticated($url) {
        $ch = curl_init();
        curl_setopt($ch, CURLOPT_URL, $url);
        curl_setopt($ch, CURLOPT_RETURNTRANSFER, true);
        curl_setopt($ch, CURLOPT_COOKIEFILE, $this->cookieFile);
        return curl_exec($ch);
    }
}
\end{lstlisting}

\subsection{Heuristic Smart Filtering}
Instead of relying on computationally expensive AI analysis, the system applies heuristic rules via the \texttt{SmartFilters} static class in \texttt{includes/smart\_filters.php} to filter junk files efficiently:
\begin{itemize}
    \item \textbf{Size Heuristics:} The \texttt{filterImagesBySize()} method discards images smaller than 5KB (likely icons/spacers) and larger than 10MB (unnecessary high-res). \texttt{filterDocumentsBySize()} removes documents under 1KB (empty/corrupt) or over 100MB (backups/archives).
    \item \textbf{Pattern Matching:} The \texttt{filterByUrlPattern()} method uses regex to skip files with names containing \texttt{logo}, \texttt{banner}, \texttt{icon}, \texttt{thumb}, \texttt{ad}, \texttt{track}, \texttt{pixel}, or \texttt{sprite}. 
    \item \textbf{Quality Scoring:} The \texttt{calculateQualityScore()} method assigns scores based on file extension (PDF=10, PNG=8, JPG=7), size (optimal ranges get bonus points), and URL patterns (penalizes \texttt{thumb}, \texttt{small}, \texttt{preview}). The \texttt{sortByQuality()} method ranks results.
    \item \textbf{Unified Filtering:} The \texttt{applyAllFilters()} method chains all filters together for one-step processing.
\end{itemize}

\begin{lstlisting}[language=PHP, caption={Smart Filtering Heuristics (smart\_filters.php)}, label={lst:smart_filters}]
class SmartFilters {
    public static function filterImagesBySize($imageUrls, $minSize = 5000, $maxSize = 10485760) {
        $filtered = [];
        foreach ($imageUrls as $url) {
            // Quick check: estimate from URL
            if (self::isLikelyIcon($url)) {
                continue;
            }
            
            $size = self::getFileSize($url);
            if ($size === false) {
                $filtered[] = $url;
                continue;
            }
            
            // Filter by size range (5KB - 10MB)
            if ($size >= $minSize && $size <= $maxSize) {
                $filtered[] = $url;
            }
        }
        return $filtered;
    }
    
    private static function isLikelyIcon($url) {
        $iconPatterns = [
            '/icon/i', '/logo/i', '/favicon/i', '/sprite/i',
            '/thumb/i', '/avatar/i', '/emoji/i', '/badge/i',
            '/-16x16\./i', '/-32x32\./i'
        ];
        
        foreach ($iconPatterns as $pattern) {
            if (preg_match($pattern, $url)) {
                return true;
            }
        }
        return false;
    }
    
    private static function getFileSize($url) {
        $ch = curl_init($url);
        curl_setopt($ch, CURLOPT_NOBODY, true); // HEAD request only
        curl_setopt($ch, CURLOPT_RETURNTRANSFER, true);
        curl_setopt($ch, CURLOPT_TIMEOUT, 5);
        curl_exec($ch);
        $size = curl_getinfo($ch, CURLINFO_CONTENT_LENGTH_DOWNLOAD);
        curl_close($ch);
        return $size > 0 ? (int)$size : false;
    }
    
    public static function filterByUrlPattern($urls, $excludePatterns = []) {
        $defaultExcludes = [
            '/ads?[/_-]/i', '/banner/i', '/tracking/i',
            '/analytics/i', '/share[_-]?button/i'
        ];
        $patterns = array_merge($defaultExcludes, $excludePatterns);
        
        return array_filter($urls, function($url) use ($patterns) {
            foreach ($patterns as $pattern) {
                if (preg_match($pattern, $url)) {
                    return false;
                }
            }
            return true;
        });
    }
}
\end{lstlisting}

